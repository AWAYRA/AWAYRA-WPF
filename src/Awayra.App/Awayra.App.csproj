<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\awayra.ico</ApplicationIcon>
    <AssemblyName>Awayra</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Awayra.App</RootNamespace>
    <!-- Version, Product and Copyright come from Directory.Build.props. -->
    <Authors>Farzin Alavi</Authors>
    <Company>Farzin Alavi</Company>
    <Description>A calm break reminder for healthier computer use</Description>
    <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("o"))</BuildTimestampUtc>

    <!-- The SDK otherwise appends the full commit SHA to whatever InformationalVersion is set below,
         producing "1.3.0+620342b.620342b0a54d31...". The short SHA alone is what gets logged. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The AssemblyMetadata items are created inside the target, not in a static ItemGroup. Static
       items are evaluated before any target runs, so they captured empty values and every build
       reported GitCommit= and WorkingTreeStatus= in its startup log.
       git rev-parse can also return several lines; only the first is the SHA. -->
  <Target Name="PopulateGitMetadata" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)\..\..">
      <Output TaskParameter="ConsoleOutput" ItemName="GitCommitShaLines" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)\..\..">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatusOutput" />
    </Exec>
    <PropertyGroup>
      <GitCommitSha>%(GitCommitShaLines.Identity)</GitCommitSha>
      <GitCommitSha Condition="'$(GitCommitSha)' == ''">unknown</GitCommitSha>
      <WorkingTreeStatus Condition="'$(GitStatusOutput)' == ''">clean</WorkingTreeStatus>
      <WorkingTreeStatus Condition="'$(GitStatusOutput)' != ''">dirty</WorkingTreeStatus>
      <InformationalVersion>$(Version)+$(GitCommitSha)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommitSha)" />
      <AssemblyMetadata Include="WorkingTreeStatus" Value="$(WorkingTreeStatus)" />
      <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\awayra.ico" />
    <ContentWithTargetPath Include="Assets\awayra.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\awayra.ico</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Awayra.Core\Awayra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>