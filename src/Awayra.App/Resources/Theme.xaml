<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette -->
  <Color x:Key="PrimaryText">#FFF4F7FB</Color>
  <Color x:Key="SecondaryText">#FFC7D0E0</Color>
  <Color x:Key="MutedText">#FF98A4B8</Color>
  <Color x:Key="DarkSurface">#FF1A1E24</Color>
  <Color x:Key="DarkSurfaceElevated">#FF20252D</Color>
  <Color x:Key="DarkBorder">#FF46505E</Color>
  <Color x:Key="Accent">#FF4DBCF3</Color>
  <Color x:Key="AccentHover">#FF67C8F7</Color>
  <Color x:Key="AccentPressed">#FF32A9E3</Color>
  <Color x:Key="AccentText">#FF07131C</Color>
  <Color x:Key="DisabledText">#FF717B89</Color>
  <Color x:Key="LightWindowBackground">#FFF4F7FB</Color>
  <Color x:Key="LightPrimaryText">#FF111827</Color>
  <Color x:Key="LightInputBackground">#FFFFFFFF</Color>
  <Color x:Key="LightInputText">#FF111827</Color>
  <Color x:Key="Validation">#FFFF6B6B</Color>
  <Color x:Key="OverlayScrim">#660E1116</Color>

  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}" />
  <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurface}" />
  <SolidColorBrush x:Key="DarkSurfaceElevatedBrush" Color="{StaticResource DarkSurfaceElevated}" />
  <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorder}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentText}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledText}" />
  <SolidColorBrush x:Key="LightWindowBackgroundBrush" Color="{StaticResource LightWindowBackground}" />
  <SolidColorBrush x:Key="LightPrimaryTextBrush" Color="{StaticResource LightPrimaryText}" />
  <SolidColorBrush x:Key="LightInputBackgroundBrush" Color="{StaticResource LightInputBackground}" />
  <SolidColorBrush x:Key="LightInputTextBrush" Color="{StaticResource LightInputText}" />
  <SolidColorBrush x:Key="ValidationBrush" Color="{StaticResource Validation}" />
  <SolidColorBrush x:Key="OverlayScrimBrush" Color="{StaticResource OverlayScrim}" />

  <!-- Legacy aliases -->
  <SolidColorBrush x:Key="Awayra.BackgroundBrush" Color="{StaticResource LightWindowBackground}" />
  <SolidColorBrush x:Key="Awayra.SurfaceBrush" Color="{StaticResource DarkSurface}" />
  <SolidColorBrush x:Key="Awayra.BorderBrush" Color="{StaticResource DarkBorder}" />
  <SolidColorBrush x:Key="Awayra.TextBrush" Color="{StaticResource PrimaryText}" />
  <SolidColorBrush x:Key="Awayra.TextMutedBrush" Color="{StaticResource SecondaryText}" />
  <SolidColorBrush x:Key="Awayra.AccentBrush" Color="{StaticResource Accent}" />

  <FontFamily x:Key="Awayra.Font">Segoe UI Variable, Segoe UI, Tahoma</FontFamily>

  <!-- Scoped resources for dark cards and overlay panels -->
  <ResourceDictionary x:Key="Awayra.DarkSurfaceResources">
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Box"
                      Width="16" Height="16"
                      CornerRadius="3"
                      BorderBrush="{StaticResource DarkBorderBrush}"
                      BorderThickness="1.5"
                      Background="{StaticResource DarkSurfaceElevatedBrush}"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                <Path x:Name="CheckMark"
                      Data="M 2,5 L 5,8 L 10,2"
                      Stroke="{StaticResource PrimaryTextBrush}"
                      StrokeThickness="2"
                      Visibility="Collapsed"
                      Margin="1" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource AccentTextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
  </ResourceDictionary>

  <!-- Light chrome windows (dashboard, settings) -->
  <Style x:Key="Awayra.LightChromeWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource LightWindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LightPrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
  </Style>

  <!-- Dark chrome windows (if needed elsewhere) -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource LightWindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LightPrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
  </Style>

  <Style x:Key="Awayra.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DarkSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Inheritable foreground for content inside dark cards and overlays -->
  <Style x:Key="Awayra.CardContent" TargetType="FrameworkElement">
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <!-- Muted text inside dark cards -->
  <Style x:Key="Awayra.MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <!-- Input controls -->
  <Style x:Key="Awayra.InputTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource LightInputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LightInputTextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource LightInputTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        <Setter Property="Background" Value="#FFE8ECF2" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Awayra.InputComboBox" TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource LightInputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LightInputTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Buttons -->
  <Style x:Key="Awayra.PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource DarkBorderBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryTextBrush}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Awayra.SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource DarkSurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource Awayra.Font}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource DarkBorderBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource DarkSurfaceBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
