  <StackPanel HorizontalAlignment="Center">
    <Border Width="340" Height="190" CornerRadius="14" ClipToBounds="True"
            Background="#33101821">
      <Canvas Width="340" Height="190">
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="CameraTranslate" X="0" Y="0" />
        </Canvas.RenderTransform>

        <Rectangle Canvas.Left="-90" Canvas.Top="162" Width="540" Height="3"
                   Fill="{StaticResource Scene.GroundBrush}" />

        <!-- Workstation -->

        <!--
          Heights are set from the figure, not guessed. Its standing hip is 56 px above the floor,
          so at human proportions (hip 90 cm, desk 73 cm, seat 45 cm) the desk surface lands 46 px
          above the floor and the seat 28 px. The previous layout put the desk above the standing
          hip, which is why nobody could reach the keyboard while seated.
        -->
        <Rectangle Canvas.Left="38" Canvas.Top="48" Width="76" Height="48"
                   RadiusX="4" RadiusY="4" Fill="#FF222C3A"
                   Stroke="#FF5A6A80" StrokeThickness="1.5" />
        <Rectangle Canvas.Left="42" Canvas.Top="52" Width="68" Height="40"
                   RadiusX="2" RadiusY="2">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF2C6E93" Offset="0" />
              <GradientStop Color="#FF1B4C68" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle Canvas.Left="47" Canvas.Top="58" Width="34" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#66CFEAF7" />
        <Rectangle Canvas.Left="47" Canvas.Top="65" Width="48" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#44CFEAF7" />
        <Rectangle Canvas.Left="47" Canvas.Top="72" Width="40" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#44CFEAF7" />
        <Rectangle Canvas.Left="47" Canvas.Top="79" Width="26" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#33CFEAF7" />
        <Rectangle Canvas.Left="72" Canvas.Top="96" Width="8" Height="16" Fill="#FF4A5568" />
        <Rectangle Canvas.Left="58" Canvas.Top="111" Width="36" Height="5"
                   RadiusX="2.5" RadiusY="2.5" Fill="#FF5A6A80" />

        <Rectangle Canvas.Left="10" Canvas.Top="116" Width="120" Height="7"
                   RadiusX="3" RadiusY="3" Fill="{StaticResource Scene.DeskBrush}" />
        <Rectangle Canvas.Left="10" Canvas.Top="116" Width="120" Height="2"
                   RadiusX="1" RadiusY="1" Fill="{StaticResource Scene.DeskEdgeBrush}" />
        <Rectangle Canvas.Left="17" Canvas.Top="123" Width="5" Height="39" Fill="{StaticResource Scene.DeskBrush}" />
        <Rectangle Canvas.Left="118" Canvas.Top="123" Width="5" Height="39" Fill="{StaticResource Scene.DeskBrush}" />
        <Rectangle Canvas.Left="22" Canvas.Top="143" Width="96" Height="3" Fill="#FF3C4757" />

        <Rectangle Canvas.Left="68" Canvas.Top="112" Width="46" Height="4"
                   RadiusX="2" RadiusY="2" Fill="#FF6B7A92" />
        <Ellipse Canvas.Left="118" Canvas.Top="111" Width="11" Height="5" Fill="#FF6B7A92" />
        <Rectangle Canvas.Left="22" Canvas.Top="104" Width="12" Height="12"
                   RadiusX="2" RadiusY="2" Fill="#FF7C8CA5" />
        <Path Stroke="#FF7C8CA5" StrokeThickness="2" Fill="Transparent"
              Data="M 34,107 C 39,107 39,113 34,113" />

        <Rectangle Canvas.Left="163" Canvas.Top="86" Width="8" Height="50"
                   RadiusX="4" RadiusY="4" Fill="#FF4A5568" />
        <Rectangle Canvas.Left="161" Canvas.Top="90" Width="4" Height="42"
                   RadiusX="2" RadiusY="2" Fill="#FF61708A" />
        <Rectangle Canvas.Left="130" Canvas.Top="134" Width="42" Height="7"
                   RadiusX="3.5" RadiusY="3.5" Fill="#FF4A5568" />
        <Rectangle Canvas.Left="130" Canvas.Top="134" Width="42" Height="2"
                   RadiusX="1" RadiusY="1" Fill="#FF61708A" />
        <Rectangle Canvas.Left="148" Canvas.Top="141" Width="6" Height="14" Fill="#FF5A6A80" />
        <Path Stroke="#FF5A6A80" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 151,155 L 133,161 M 151,155 L 169,161" />
        <Ellipse Canvas.Left="128" Canvas.Top="157" Width="8" Height="8" Fill="#FF3C4757" />
        <Ellipse Canvas.Left="164" Canvas.Top="157" Width="8" Height="8" Fill="#FF3C4757" />

        <!-- Walker: both rigs share this position -->
        <Canvas Canvas.Left="140" Canvas.Top="105">
          <Canvas.RenderTransform>
            <TranslateTransform x:Name="BodyTranslate" X="2" Y="25" />
          </Canvas.RenderTransform>

          <!-- Profile rig -->
          <Canvas>
            <Canvas.RenderTransform>
              <ScaleTransform x:Name="BodyFlip" ScaleX="-1" ScaleY="1" />
            </Canvas.RenderTransform>

            <Canvas>
              <Canvas.RenderTransform>
                <RotateTransform x:Name="FarThighRotate" Angle="-78" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-4" Canvas.Top="0" Width="8" Height="26"
                         Style="{StaticResource Scene.FarLimb}" />
              <Canvas Canvas.Top="26">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="FarShinRotate" Angle="78" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-3.5" Canvas.Top="0" Width="7" Height="25"
                           Style="{StaticResource Scene.FarLimb}" />
                <Rectangle Canvas.Left="-4" Canvas.Top="23" Width="14" Height="5"
                           Style="{StaticResource Scene.FarLimb}" />
              </Canvas>
            </Canvas>

            <Canvas>
              <Canvas.RenderTransform>
                <RotateTransform x:Name="TorsoRotate" Angle="16" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>

              <Canvas Canvas.Top="-36">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="FarArmRotate" Angle="-44" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-3" Canvas.Top="0" Width="6.5" Height="21"
                           Style="{StaticResource Scene.FarLimb}" />
                <Canvas Canvas.Top="20">
                  <Canvas.RenderTransform>
                    <RotateTransform x:Name="FarForearmRotate" Angle="-86" CenterX="0" CenterY="0" />
                  </Canvas.RenderTransform>
                  <Rectangle Canvas.Left="-2.75" Canvas.Top="0" Width="6" Height="19"
                             Style="{StaticResource Scene.FarLimb}" />
                </Canvas>
              </Canvas>

              <Rectangle Canvas.Left="-8" Canvas.Top="-42" Width="16" Height="44"
                         RadiusX="7" RadiusY="7" Fill="{StaticResource Scene.BodyBrush}" />
              <Ellipse Canvas.Left="-11" Canvas.Top="-66" Width="22" Height="22"
                       Fill="{StaticResource Scene.BodyBrush}" />

              <Canvas Canvas.Top="-36">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="NearArmRotate" Angle="-49" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-3.25" Canvas.Top="0" Width="7" Height="21"
                           Style="{StaticResource Scene.Limb}" />
                <Canvas Canvas.Top="21">
                  <Canvas.RenderTransform>
                    <RotateTransform x:Name="NearForearmRotate" Angle="-82" CenterX="0" CenterY="0" />
                  </Canvas.RenderTransform>
                  <Rectangle Canvas.Left="-3" Canvas.Top="0" Width="6.5" Height="20"
                             Style="{StaticResource Scene.Limb}" />
                </Canvas>
              </Canvas>
            </Canvas>

            <Canvas>
              <Canvas.RenderTransform>
                <RotateTransform x:Name="NearThighRotate" Angle="-82" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-4.5" Canvas.Top="0" Width="9" Height="26"
                         Style="{StaticResource Scene.Limb}" />
              <Canvas Canvas.Top="26">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="NearShinRotate" Angle="82" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-4" Canvas.Top="0" Width="8" Height="25"
                           Style="{StaticResource Scene.Limb}" />
                <Rectangle Canvas.Left="-4.5" Canvas.Top="23" Width="15" Height="5.5"
                           Style="{StaticResource Scene.Limb}" />
              </Canvas>
            </Canvas>
          </Canvas>

          <!-- Front-facing rig, used for the squats and jumps -->
          <Canvas>
            <Canvas.RenderTransform>
              <ScaleTransform x:Name="FrontScale" ScaleX="0" ScaleY="1" CenterX="0" CenterY="0" />
            </Canvas.RenderTransform>

            <!-- Both legs compress together, which is what lowers the hips. -->
            <Canvas>
              <Canvas.RenderTransform>
                <ScaleTransform x:Name="FrontLegsScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>

              <Canvas Canvas.Left="-7">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="FrontLeftThighRotate" Angle="0" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-5" Canvas.Top="0" Width="10" Height="26"
                           Style="{StaticResource Scene.Limb}" />
                <Canvas Canvas.Top="26">
                  <Canvas.RenderTransform>
                    <RotateTransform x:Name="FrontLeftShinRotate" Angle="0" CenterX="0" CenterY="0" />
                  </Canvas.RenderTransform>
                  <Rectangle Canvas.Left="-4.5" Canvas.Top="0" Width="9" Height="25"
                             Style="{StaticResource Scene.Limb}" />
                  <Rectangle Canvas.Left="-6" Canvas.Top="23" Width="12" Height="5.5"
                             Style="{StaticResource Scene.Limb}" />
                </Canvas>
              </Canvas>

              <Canvas Canvas.Left="7">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="FrontRightThighRotate" Angle="0" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-5" Canvas.Top="0" Width="10" Height="26"
                           Style="{StaticResource Scene.Limb}" />
                <Canvas Canvas.Top="26">
                  <Canvas.RenderTransform>
                    <RotateTransform x:Name="FrontRightShinRotate" Angle="0" CenterX="0" CenterY="0" />
                  </Canvas.RenderTransform>
                  <Rectangle Canvas.Left="-4.5" Canvas.Top="0" Width="9" Height="25"
                             Style="{StaticResource Scene.Limb}" />
                  <Rectangle Canvas.Left="-6" Canvas.Top="23" Width="12" Height="5.5"
                             Style="{StaticResource Scene.Limb}" />
                </Canvas>
              </Canvas>
            </Canvas>

            <Canvas Canvas.Left="-14" Canvas.Top="-38">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="FrontLeftArmRotate" Angle="8" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-3.5" Canvas.Top="0" Width="7" Height="21"
                         Style="{StaticResource Scene.Limb}" />
              <Rectangle Canvas.Left="-3.25" Canvas.Top="20" Width="6.5" Height="19"
                         Style="{StaticResource Scene.Limb}" />
            </Canvas>

            <Canvas Canvas.Left="14" Canvas.Top="-38">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="FrontRightArmRotate" Angle="-8" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-3.5" Canvas.Top="0" Width="7" Height="21"
                         Style="{StaticResource Scene.Limb}" />
              <Rectangle Canvas.Left="-3.25" Canvas.Top="20" Width="6.5" Height="19"
                         Style="{StaticResource Scene.Limb}" />
            </Canvas>

            <Rectangle Canvas.Left="-13" Canvas.Top="-44" Width="26" Height="46"
                       RadiusX="9" RadiusY="9" Fill="{StaticResource Scene.BodyBrush}" />
            <Ellipse Canvas.Left="-12" Canvas.Top="-68" Width="24" Height="24"
                     Fill="{StaticResource Scene.BodyBrush}" />
          </Canvas>
        </Canvas>
      </Canvas>
    </Border>

    <TextBlock x:Name="MoveCaptionText"
               AutomationProperties.AutomationId="MoveExerciseCaption"
               Text="Time to leave the keyboard"
               Margin="0,10,0,0"
               HorizontalAlignment="Center"
               FontFamily="{StaticResource Overlay.Font}"
               FontSize="15"
               FontWeight="SemiBold"
               Foreground="{StaticResource Overlay.AccentBrush}" />
  </StackPanel>
</UserControl>
