<UserControl x:Class="Awayra.App.Views.MoveExerciseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="MoveExerciseAnimation"
             Focusable="False"
             IsHitTestVisible="False">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/OverlayStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="Scene.DeskBrush" Color="#FF4A5568" />
      <SolidColorBrush x:Key="Scene.DeskEdgeBrush" Color="#FF61708A" />
      <SolidColorBrush x:Key="Scene.GroundBrush" Color="#FF2A3340" />
      <SolidColorBrush x:Key="Scene.BodyBrush" Color="#FF58C2F4" />
      <SolidColorBrush x:Key="Scene.BodyFarBrush" Color="#FF2F7FA6" />

      <Style x:Key="Scene.Limb" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Scene.BodyBrush}" />
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
      </Style>

      <Style x:Key="Scene.FarLimb" TargetType="Rectangle" BasedOn="{StaticResource Scene.Limb}">
        <Setter Property="Fill" Value="{StaticResource Scene.BodyFarBrush}" />
      </Style>

      <!--
        A twenty-second round trip.

        Two rigs share one position. The profile rig sits, types, walks and stretches; the
        front-facing rig does the squats and jumps, because a squat seen edge-on hides the very
        thing that makes it a squat. Turning between them is a fast horizontal squeeze of one rig
        while the other expands, which reads as the figure pivoting to face you.

        The pose at 0:00 and 0:20 is identical, so the loop has no visible seam.
      -->
      <Storyboard x:Key="Move.Storyboard" RepeatBehavior="Forever">

        <!-- Camera: a loose follow, panning less than the walker travels so the desk stays in frame. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CameraTranslate"
                                       Storyboard.TargetProperty="X" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:2.98" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:5.6" Value="-46" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.6" Value="-46" />
          <SplineDoubleKeyFrame KeyTime="0:0:17.1" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                       Storyboard.TargetProperty="X" Duration="0:0:20">
          <!-- Seated on the chair, then a step clear of it before walking off. -->
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="2" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="-10" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:2.98" Value="-10" />
          <SplineDoubleKeyFrame KeyTime="0:0:5.6" Value="92" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.6" Value="92" />
          <SplineDoubleKeyFrame KeyTime="0:0:17.1" Value="-10" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.7" Value="-10" />
          <SplineDoubleKeyFrame KeyTime="0:0:20" Value="2" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Hip height: seated, upright, three squats, then three jumps clear of the floor. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                       Storyboard.TargetProperty="Y" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="25" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="0" />

          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="18" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.43" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="18" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:11.46" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="18" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="0" KeySpline="0.3,0,0.3,1" />

          <LinearDoubleKeyFrame KeyTime="0:0:12.6" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.72" Value="10" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.88" Value="-22" KeySpline="0.1,0.7,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.04" Value="8" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.32" Value="10" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.48" Value="-22" KeySpline="0.1,0.7,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.64" Value="8" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.8" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.92" Value="10" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.08" Value="-22" KeySpline="0.1,0.7,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.24" Value="8" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.4" Value="0" KeySpline="0.3,0,0.3,1" />

          <LinearDoubleKeyFrame KeyTime="0:0:17.7" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:20" Value="25" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Profile rig: faces the desk, then the walking direction, then squeezes away entirely. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyFlip"
                                       Storyboard.TargetProperty="ScaleX" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="-1" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.98" Value="1" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.3" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.4" Value="0" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.4" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.6" Value="-1" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="-1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Front rig: only present while the figure is facing you. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontScale"
                                       Storyboard.TargetProperty="ScaleX" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.3" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.4" Value="1" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.4" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.5" Value="0" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <!--
          Compressing both front legs together is what lets the hips drop while the feet stay on
          the floor: at 0.62 the leg is 31 px instead of 51, which is exactly the 18 px the hips
          fall. At the top of a jump it barely tucks, so the feet leave the ground.
        -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontLegsScale"
                                       Storyboard.TargetProperty="ScaleY" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="0.62" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="1" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.43" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="0.62" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="1" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:11.46" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="0.62" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="1" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12.6" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.72" Value="0.80" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.88" Value="0.88" KeySpline="0.3,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.04" Value="0.84" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="1" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.32" Value="0.80" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.48" Value="0.88" KeySpline="0.3,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.64" Value="0.84" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.8" Value="1" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.92" Value="0.80" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.08" Value="0.88" KeySpline="0.3,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.24" Value="0.84" KeySpline="0.6,0,0.9,0.4" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.4" Value="1" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Knees track apart in the squat and stay closer together in the jump. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontLeftThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontRightThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <!--
          The shins counter-rotate by exactly what the thighs splay, which keeps them vertical and
          gives the knees-out silhouette of a squat. Without this the legs simply splay straight
          and the pose reads as a star jump.
        -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontLeftShinRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="-17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontRightShinRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="0" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="17" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="0" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Arms out for balance in the squat, thrown overhead on every jump. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontLeftArmRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="8" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="8" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12.6" Value="8" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.72" Value="-18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.88" Value="162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.04" Value="40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.32" Value="-18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.48" Value="162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.64" Value="40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.8" Value="8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.92" Value="-18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.08" Value="162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.24" Value="40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.4" Value="8" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="8" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FrontRightArmRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:9.4" Value="-8" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.82" Value="-78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.3" Value="-8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:10.85" Value="-78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.33" Value="-8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:11.88" Value="-78" KeySpline="0.4,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.36" Value="-8" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12.6" Value="-8" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.72" Value="18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:12.88" Value="-162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.04" Value="-40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="-8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.32" Value="18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.48" Value="-162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.64" Value="-40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.8" Value="-8" KeySpline="0.3,0,0.3,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:13.92" Value="18" KeySpline="0.4,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.08" Value="-162" KeySpline="0.2,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.24" Value="-40" KeySpline="0.6,0,0.4,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:14.4" Value="-8" KeySpline="0.3,0,0.3,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:20" Value="-8" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Profile rig timeline -->

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TorsoRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="16" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="22" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:6.5" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.95" Value="16" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.4" Value="-16" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.7" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.7" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:20" Value="16" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="-82" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:2.98" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.635" Value="24" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.29" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.945" Value="-24" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:15.225" Value="24" />
          <LinearDoubleKeyFrame KeyTime="0:0:15.85" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:16.475" Value="-24" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.1" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.7" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:20" Value="-82" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearShinRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="82" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:2.98" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.635" Value="6" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.29" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.945" Value="18" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:14.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:15.225" Value="6" />
          <LinearDoubleKeyFrame KeyTime="0:0:15.85" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:16.475" Value="18" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.1" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:17.7" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:20" Value="82" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FarThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:20">
          <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="-78" />
