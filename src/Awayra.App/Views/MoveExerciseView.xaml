<UserControl x:Class="Awayra.App.Views.MoveExerciseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="MoveExerciseAnimation"
             Focusable="False"
             IsHitTestVisible="False">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/OverlayStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="Scene.FurnitureBrush" Color="#FF3A4554" />
      <SolidColorBrush x:Key="Scene.FurnitureEdgeBrush" Color="#FF55627A" />
      <SolidColorBrush x:Key="Scene.GroundBrush" Color="#FF2A3340" />
      <SolidColorBrush x:Key="Scene.BodyBrush" Color="#FF58C2F4" />
      <SolidColorBrush x:Key="Scene.BodyFarBrush" Color="#FF2F7FA6" />

      <Style x:Key="Scene.Limb" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Scene.BodyBrush}" />
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
      </Style>

      <Style x:Key="Scene.FarLimb" TargetType="Rectangle" BasedOn="{StaticResource Scene.Limb}">
        <Setter Property="Fill" Value="{StaticResource Scene.BodyFarBrush}" />
      </Style>

      <!--
        One twelve-second round trip: sit, stand, turn, walk out, stretch, walk back, sit.
        The pose at 0:00 and 0:12 is identical, so the loop returns to where it started with no
        visible seam - the boomerang the animation is meant to read as.
      -->
      <Storyboard x:Key="Move.Storyboard" RepeatBehavior="Forever">

        <!-- Camera: a loose follow, panning less than the walker travels so the desk stays in frame. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CameraTranslate"
                                       Storyboard.TargetProperty="X" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:5.8" Value="-46" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.2" Value="-46" />
          <SplineDoubleKeyFrame KeyTime="0:0:11" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Walker position along the floor. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                       Storyboard.TargetProperty="X" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:5.8" Value="92" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.2" Value="92" />
          <SplineDoubleKeyFrame KeyTime="0:0:11" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Seat height: down in the chair, up on both feet. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                       Storyboard.TargetProperty="Y" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="26" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="26" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!--
          Turning around is a horizontal flip. It has to be quick: the figure is edge-on and
          therefore invisible as the scale crosses zero, so a slow flip reads as the person
          vanishing rather than pivoting on the spot.
        -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyFlip"
                                       Storyboard.TargetProperty="ScaleX" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="-1" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.78" Value="1" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.02" Value="1" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.2" Value="-1" KeySpline="0.5,0,0.5,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:12" Value="-1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Torso: hunched at the desk, upright walking, arched back in the stretch, side bends. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TorsoRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="14" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="20" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.4" Value="-9" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.8" Value="0" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.1" Value="15" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.4" Value="-15" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.6" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:11.2" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="14" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Near thigh. 90 degrees is horizontal, i.e. seated. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-82" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="24" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="-24" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:6.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:7.9" Value="10" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="24" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="-82" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Near shin. Seated it drops vertically from the horizontal thigh. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearShinRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="82" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="6" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="18" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="6" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="82" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Far thigh, half a stride out of phase with the near leg. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FarThighRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-78" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="-24" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="24" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:6.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:7.9" Value="-10" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="-24" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="-78" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FarShinRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="78" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="12" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="6" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="34" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="12" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="78" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Near arm: typing, swinging, reaching overhead, then circling. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearArmRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="-38" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="-33" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="-38" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-33" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="-26" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="26" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.4" Value="158" KeySpline="0.3,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.8" Value="158" KeySpline="0,0,1,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.6" Value="150" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:7.9" Value="270" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.2" Value="380" />
          <SplineDoubleKeyFrame KeyTime="0:0:8.6" Value="360" KeySpline="0.4,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:9.2" Value="360" KeySpline="0,0,1,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="386" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="334" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="360" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="322" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NearForearmRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="52" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="12" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="12" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.4" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.6" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="12" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="52" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Far arm mirrors the near arm through the walk and joins the overhead stretch. -->
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FarArmRotate"
                                       Storyboard.TargetProperty="Angle" Duration="0:0:12">
          <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="-33" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="-38" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="-33" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-38" />
          <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" KeySpline="0.3,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="26" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.15" Value="-26" />
          <LinearDoubleKeyFrame KeyTime="0:0:5.8" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.4" Value="202" KeySpline="0.3,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:6.8" Value="202" KeySpline="0,0,1,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:7.6" Value="210" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:7.9" Value="100" />
          <LinearDoubleKeyFrame KeyTime="0:0:8.2" Value="-20" />
          <SplineDoubleKeyFrame KeyTime="0:0:8.6" Value="0" KeySpline="0.4,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:9.65" Value="-26" />
          <LinearDoubleKeyFrame KeyTime="0:0:10.3" Value="26" />
          <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:12" Value="-38" KeySpline="0.4,0,0.6,1" />
        </DoubleAnimationUsingKeyFrames>

        <!-- Caption tracks the phase so the movement is never ambiguous. -->
        <StringAnimationUsingKeyFrames Storyboard.TargetName="MoveCaptionText"
                                       Storyboard.TargetProperty="Text" Duration="0:0:12">
          <DiscreteStringKeyFrame KeyTime="0:0:0" Value="Time to leave the chair" />
          <DiscreteStringKeyFrame KeyTime="0:0:1.6" Value="Stand up" />
          <DiscreteStringKeyFrame KeyTime="0:0:3.2" Value="Walk it off" />
          <DiscreteStringKeyFrame KeyTime="0:0:5.8" Value="Reach up and stretch" />
          <DiscreteStringKeyFrame KeyTime="0:0:6.8" Value="Bend side to side" />
          <DiscreteStringKeyFrame KeyTime="0:0:7.6" Value="Roll your shoulders" />
          <DiscreteStringKeyFrame KeyTime="0:0:8.6" Value="Head back to your desk" />
          <DiscreteStringKeyFrame KeyTime="0:0:11" Value="Sit down refreshed" />
        </StringAnimationUsingKeyFrames>
      </Storyboard>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel HorizontalAlignment="Center">
    <Border Width="320" Height="176" CornerRadius="14" ClipToBounds="True"
            Background="#33101821">
      <Canvas Width="320" Height="176">
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="CameraTranslate" X="0" Y="0" />
        </Canvas.RenderTransform>

        <!-- Floor -->
        <Rectangle Canvas.Left="-80" Canvas.Top="150" Width="520" Height="3"
                   Fill="{StaticResource Scene.GroundBrush}" />

        <!-- Desk and monitor, seen from slightly behind the walker. -->
        <Rectangle Canvas.Left="16" Canvas.Top="96" Width="104" Height="7"
                   RadiusX="3" RadiusY="3" Fill="{StaticResource Scene.FurnitureEdgeBrush}" />
        <Rectangle Canvas.Left="22" Canvas.Top="103" Width="5" Height="47"
                   Fill="{StaticResource Scene.FurnitureBrush}" />
        <Rectangle Canvas.Left="109" Canvas.Top="103" Width="5" Height="47"
                   Fill="{StaticResource Scene.FurnitureBrush}" />
        <Rectangle Canvas.Left="44" Canvas.Top="56" Width="52" Height="34"
                   RadiusX="4" RadiusY="4" Fill="{StaticResource Scene.FurnitureBrush}"
                   Stroke="{StaticResource Scene.FurnitureEdgeBrush}" StrokeThickness="1.5" />
        <Rectangle Canvas.Left="67" Canvas.Top="90" Width="6" Height="6"
                   Fill="{StaticResource Scene.FurnitureEdgeBrush}" />

        <!-- Chair -->
        <Rectangle Canvas.Left="126" Canvas.Top="118" Width="42" Height="6"
                   RadiusX="3" RadiusY="3" Fill="{StaticResource Scene.FurnitureEdgeBrush}" />
        <Rectangle Canvas.Left="160" Canvas.Top="80" Width="6" Height="40"
                   RadiusX="3" RadiusY="3" Fill="{StaticResource Scene.FurnitureEdgeBrush}" />
        <Rectangle Canvas.Left="144" Canvas.Top="124" Width="5" Height="26"
                   Fill="{StaticResource Scene.FurnitureBrush}" />

        <!-- Walker. Pelvis sits at the canvas origin of this group. -->
        <Canvas Canvas.Left="136" Canvas.Top="98">
          <Canvas.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="BodyFlip" ScaleX="-1" ScaleY="1" />
              <TranslateTransform x:Name="BodyTranslate" X="0" Y="26" />
            </TransformGroup>
          </Canvas.RenderTransform>

          <!-- Far leg, drawn first so it sits behind the torso. -->
          <Canvas>
            <Canvas.RenderTransform>
              <RotateTransform x:Name="FarThighRotate" Angle="-78" CenterX="0" CenterY="0" />
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="-4" Canvas.Top="0" Width="8" Height="26"
                       Style="{StaticResource Scene.FarLimb}" />
            <Canvas Canvas.Top="26">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="FarShinRotate" Angle="78" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-3.5" Canvas.Top="0" Width="7" Height="25"
                         Style="{StaticResource Scene.FarLimb}" />
              <Rectangle Canvas.Left="-4" Canvas.Top="23" Width="14" Height="5"
                         Style="{StaticResource Scene.FarLimb}" />
            </Canvas>
          </Canvas>

          <!-- Torso, head and arms. -->
          <Canvas>
            <Canvas.RenderTransform>
              <RotateTransform x:Name="TorsoRotate" Angle="14" CenterX="0" CenterY="0" />
            </Canvas.RenderTransform>

            <!-- Far arm hangs behind the torso. -->
            <Canvas Canvas.Top="-36">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="FarArmRotate" Angle="-38" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-3" Canvas.Top="0" Width="6.5" Height="21"
                         Style="{StaticResource Scene.FarLimb}" />
              <Rectangle Canvas.Left="-2.75" Canvas.Top="20" Width="6" Height="19"
                         Style="{StaticResource Scene.FarLimb}" />
            </Canvas>

            <Rectangle Canvas.Left="-8" Canvas.Top="-42" Width="16" Height="44"
                       RadiusX="7" RadiusY="7" Fill="{StaticResource Scene.BodyBrush}" />
            <Ellipse Canvas.Left="-11" Canvas.Top="-66" Width="22" Height="22"
                     Fill="{StaticResource Scene.BodyBrush}" />

            <!-- Near arm in front. -->
            <Canvas Canvas.Top="-36">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="NearArmRotate" Angle="-38" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-3.25" Canvas.Top="0" Width="7" Height="21"
                         Style="{StaticResource Scene.Limb}" />
              <Canvas Canvas.Top="21">
                <Canvas.RenderTransform>
                  <RotateTransform x:Name="NearForearmRotate" Angle="52" CenterX="0" CenterY="0" />
                </Canvas.RenderTransform>
                <Rectangle Canvas.Left="-3" Canvas.Top="0" Width="6.5" Height="20"
                           Style="{StaticResource Scene.Limb}" />
              </Canvas>
            </Canvas>
          </Canvas>

          <!-- Near leg in front. -->
          <Canvas>
            <Canvas.RenderTransform>
              <RotateTransform x:Name="NearThighRotate" Angle="-82" CenterX="0" CenterY="0" />
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="-4.5" Canvas.Top="0" Width="9" Height="26"
                       Style="{StaticResource Scene.Limb}" />
            <Canvas Canvas.Top="26">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="NearShinRotate" Angle="82" CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>
              <Rectangle Canvas.Left="-4" Canvas.Top="0" Width="8" Height="25"
                         Style="{StaticResource Scene.Limb}" />
              <Rectangle Canvas.Left="-4.5" Canvas.Top="23" Width="15" Height="5.5"
                         Style="{StaticResource Scene.Limb}" />
            </Canvas>
          </Canvas>
        </Canvas>
      </Canvas>
    </Border>

    <TextBlock x:Name="MoveCaptionText"
               AutomationProperties.AutomationId="MoveExerciseCaption"
               Text="Time to leave the chair"
               Margin="0,10,0,0"
               HorizontalAlignment="Center"
               FontFamily="{StaticResource Overlay.Font}"
               FontSize="15"
               FontWeight="SemiBold"
               Foreground="{StaticResource Overlay.AccentBrush}" />
  </StackPanel>
</UserControl>
