<Window x:Class="Awayra.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="MainWindow"
        Title="Awayra"
        Icon="pack://application:,,,/Awayra;component/Assets/awayra.ico"
        Width="460"
        Height="710"
        MinWidth="420"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0E1319"
        Foreground="#F7F9FC"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/DashboardStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Dashboard.CompactToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Dashboard.SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Dashboard.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid MinHeight="23">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Border x:Name="Track"
                        Grid.Column="1"
                        Width="34"
                        Height="18"
                        Margin="8,0,0,0"
                        CornerRadius="9"
                        Background="{StaticResource Dashboard.BorderBrush}"
                        BorderBrush="{StaticResource Dashboard.BorderBrush}"
                        BorderThickness="1">
                  <Ellipse x:Name="Thumb"
                           Width="14"
                           Height="14"
                           Margin="1"
                           HorizontalAlignment="Left"
                           Fill="{StaticResource Dashboard.SecondaryTextBrush}" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource Dashboard.AccentBrush}" />
                  <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Dashboard.AccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Dashboard.AccentForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Dashboard.AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Dashboard.FocusRingBrush}" />
                  <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource Dashboard.DisabledTextBrush}" />
                  <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Dashboard.TitleText}" />
      <TextBlock AutomationProperties.AutomationId="StatusText"
                 Text="{Binding StatusText}"
                 Style="{StaticResource Dashboard.StatusText}" />
    </StackPanel>

    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
      <Border Style="{StaticResource Dashboard.CountdownCard}" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Style="{StaticResource Dashboard.CardAccentBar}"
                  Background="{StaticResource Dashboard.EyeAccentBrush}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding EyeResetLabel}" Style="{StaticResource Dashboard.CardLabel}" />
            <TextBlock AutomationProperties.AutomationId="EyeCountdown"
                       Text="{Binding EyeCountdown}"
                       Style="{StaticResource Dashboard.CountdownValue}" />
            <TextBlock Text="{Binding EyeStateText}" Style="{StaticResource Dashboard.MutedText}" />
            <Border Height="1"
                    Margin="0,10,0,8"
                    Background="{StaticResource Dashboard.BorderBrush}" />
            <CheckBox AutomationProperties.AutomationId="EyeReminderToggle"
                      Content="Reminder"
                      IsChecked="{Binding EyeReminderEnabled, Mode=OneWay}"
                      Command="{Binding ToggleEyeReminderCommand}"
                      Style="{StaticResource Dashboard.CompactToggle}" />
            <CheckBox AutomationProperties.AutomationId="EyeSoundToggle"
                      Content="Sound"
                      IsChecked="{Binding EyeSoundEnabled, Mode=OneWay}"
                      Command="{Binding ToggleEyeSoundCommand}"
                      Style="{StaticResource Dashboard.CompactToggle}"
                      Margin="0" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Dashboard.CountdownCard}" Margin="6,0,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Style="{StaticResource Dashboard.CardAccentBar}"
                  Background="{StaticResource Dashboard.MoveAccentBrush}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding MoveBreakLabel}" Style="{StaticResource Dashboard.CardLabel}" />
            <TextBlock AutomationProperties.AutomationId="MoveCountdown"
                       Text="{Binding MoveCountdown}"
                       Style="{StaticResource Dashboard.CountdownValue}" />
            <TextBlock Text="{Binding MoveStateText}" Style="{StaticResource Dashboard.MutedText}" />
            <Border Height="1"
                    Margin="0,10,0,8"
                    Background="{StaticResource Dashboard.BorderBrush}" />
            <CheckBox AutomationProperties.AutomationId="MoveReminderToggle"
                      Content="Reminder"
                      IsChecked="{Binding MoveReminderEnabled, Mode=OneWay}"
                      Command="{Binding ToggleMoveReminderCommand}"
                      Style="{StaticResource Dashboard.CompactToggle}" />
            <CheckBox AutomationProperties.AutomationId="MoveSoundToggle"
                      Content="Sound"
                      IsChecked="{Binding MoveSoundEnabled, Mode=OneWay}"
                      Command="{Binding ToggleMoveSoundCommand}"
                      Style="{StaticResource Dashboard.CompactToggle}"
                      Margin="0" />
          </StackPanel>
        </Grid>
      </Border>
    </UniformGrid>

    <Border Grid.Row="2" Style="{StaticResource Dashboard.StatsSection}" Margin="0,0,0,4">
      <UniformGrid Columns="2" Rows="2">
        <Border Style="{StaticResource Dashboard.StatTile}" Margin="0,0,5,5">
          <TextBlock AutomationProperties.AutomationId="TodayEyeCompleted"
                     Text="{Binding TodayEyeText}"
                     Style="{StaticResource Dashboard.StatText}" />
        </Border>
        <Border Style="{StaticResource Dashboard.StatTile}" Margin="5,0,0,5">
          <TextBlock AutomationProperties.AutomationId="TodayMoveCompleted"
                     Text="{Binding TodayMoveText}"
                     Style="{StaticResource Dashboard.StatText}" />
        </Border>
        <Border Style="{StaticResource Dashboard.StatTile}" Margin="0,0,5,0">
          <TextBlock AutomationProperties.AutomationId="TodaySkipped"
                     Text="{Binding TodaySkippedText}"
                     Style="{StaticResource Dashboard.StatText}" />
        </Border>
        <Border Style="{StaticResource Dashboard.StatTile}" Margin="5,0,0,0">
          <TextBlock AutomationProperties.AutomationId="TodaySnoozed"
                     Text="{Binding TodaySnoozedText}"
                     Style="{StaticResource Dashboard.StatText}" />
        </Border>
      </UniformGrid>
    </Border>

    <Grid Grid.Row="3" />

    <UniformGrid Grid.Row="4" Columns="2" Margin="0,16,0,10">
      <Button AutomationProperties.AutomationId="EyeResetNowButton"
              Content="{Binding EyeResetNowLabel}"
              Command="{Binding EyeNowCommand}"
              IsEnabled="{Binding EyeReminderEnabled}"
              Style="{StaticResource Dashboard.PrimaryButton}"
              Margin="0,0,6,0" />
      <Button AutomationProperties.AutomationId="MoveBreakNowButton"
              Content="{Binding MoveBreakNowLabel}"
              Command="{Binding MoveNowCommand}"
              IsEnabled="{Binding MoveReminderEnabled}"
              Style="{StaticResource Dashboard.PrimaryButton}"
              Margin="6,0,0,0" />
    </UniformGrid>

    <UniformGrid Grid.Row="5" Columns="2" Margin="0,0,0,10">
      <Button AutomationProperties.AutomationId="PauseResumeButton"
              Content="{Binding PauseResumeText}"
              Command="{Binding TogglePauseCommand}"
              Style="{StaticResource Dashboard.SecondaryButton}"
              Margin="0,0,6,0" />
      <Button AutomationProperties.AutomationId="SettingsButton"
              Content="{Binding SettingsLabel}"
              Command="{Binding OpenSettingsCommand}"
              Style="{StaticResource Dashboard.SecondaryButton}"
              Margin="6,0,0,0" />
    </UniformGrid>

    <Button Grid.Row="6"
            AutomationProperties.AutomationId="DashboardAboutSupportButton"
            Click="DashboardAboutSupport_Click"
            Style="{StaticResource Dashboard.AboutSupportCardButton}">
      <StackPanel HorizontalAlignment="Left">
        <TextBlock Text="About &amp; Support Awayra"
                   Style="{StaticResource Dashboard.AboutSupportPrimaryText}" />
        <TextBlock Text="Built with love for people who spend long hours at a computer."
                   Style="{StaticResource Dashboard.AboutSupportSecondaryText}" />
      </StackPanel>
    </Button>
  </Grid>
</Window>
