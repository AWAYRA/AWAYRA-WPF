<Window x:Class="Awayra.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Awayra.App.Converters"
        AutomationProperties.AutomationId="AboutWindow"
        Title="About Awayra"
        Width="620"
        Height="560"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0E1319"
        Foreground="#F7F9FC"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/AboutStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="24,20">
    <StackPanel MaxWidth="560">
      <TextBlock Text="Awayra" Style="{StaticResource About.AppName}" />
      <TextBlock Text="{Binding VersionText}" Style="{StaticResource About.Version}" />
      <TextBlock Text="{Binding Tagline}" Style="{StaticResource About.Tagline}" />
      <TextBlock Text="{Binding Mission}" Style="{StaticResource About.Body}" />
      <TextBlock Text="{Binding Creator}" Style="{StaticResource About.Body}" />
      <TextBlock Text="{Binding OpenSourceStatement}" Style="{StaticResource About.Body}" />

      <Border Style="{StaticResource About.SectionCard}">
        <StackPanel>
          <Button AutomationProperties.AutomationId="AboutSourceButton"
                  Content="View source code"
                  Command="{Binding OpenSourceCommand}"
                  Style="{StaticResource About.LinkButton}" />
          <Button AutomationProperties.AutomationId="AboutIssuesButton"
                  Content="Report an issue"
                  Command="{Binding OpenIssuesCommand}"
                  Style="{StaticResource About.LinkButton}"
                  Margin="0,8,0,0" />
          <TextBlock Text="{Binding SupportDescription}"
                     Style="{StaticResource About.SupportBody}" />
          <TextBlock Text="{Binding SupportUnavailableMessage}"
                     Style="{StaticResource About.SupportBody}"
                     Visibility="{Binding ShowSupportUnavailable, Converter={StaticResource BoolToVisibility}}" />
          <Button AutomationProperties.AutomationId="AboutSupportButton"
                  Content="Support Awayra"
                  Command="{Binding OpenSupportCommand}"
                  IsEnabled="{Binding IsSupportConfigured}"
                  Style="{StaticResource About.SupportButton}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource About.ErrorPanel}"
              Visibility="{Binding HasLinkError, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding LinkErrorMessage}" Style="{StaticResource About.ErrorText}" />
          <TextBox Text="{Binding FailedUrl, Mode=OneWay}"
                   Style="{StaticResource About.ErrorUrlBox}"
                   AutomationProperties.Name="Failed link address" />
          <Button Content="Copy link"
                  Command="{Binding CopyFailedUrlCommand}"
                  Style="{StaticResource About.CopyButton}" />
        </StackPanel>
      </Border>

      <Button AutomationProperties.AutomationId="AboutCloseButton"
              Content="Close"
              Command="{Binding CloseAboutCommand}"
              Style="{StaticResource About.CloseButton}" />
    </StackPanel>
  </ScrollViewer>
</Window>
