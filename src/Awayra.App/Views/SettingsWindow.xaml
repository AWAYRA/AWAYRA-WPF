<Window x:Class="Awayra.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="Settings"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#0E1319"
        Foreground="#F7F9FC"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Settings.SoundRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Settings.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Settings.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="18" Height="18" Margin="0,0,10,0">
                  <Ellipse x:Name="Outer"
                           Fill="{StaticResource Settings.InputBackgroundBrush}"
                           Stroke="{StaticResource Settings.BorderBrush}"
                           StrokeThickness="1.5" />
                  <Ellipse x:Name="Dot"
                           Width="8"
                           Height="8"
                           Fill="{StaticResource Settings.AccentBrush}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.FocusRingBrush}" />
                  <Setter TargetName="Outer" Property="StrokeThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,4">
      <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource Settings.PageTitle}" />
        <TextBlock Text="Configure reminder intervals, sound, behavior, appearance, and Windows integration."
                   Style="{StaticResource Settings.PageDescription}"
                   Margin="0,0,0,14" />

        <Grid Style="{StaticResource Settings.TwoColumnGrid}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="340" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Style="{StaticResource Settings.ColumnStack}">
            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Eye Reset" Style="{StaticResource Settings.SectionTitle}" />
                <CheckBox Content="Enable eye reminder"
                          IsChecked="{Binding EyeResetEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <CheckBox AutomationProperties.AutomationId="EyeBreakSoundCheckbox"
                          Content="Play sound during eye breaks"
                          IsChecked="{Binding EyeBreakSoundEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Eye interval" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding EyeResetIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Eye duration" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding EyeResetDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="seconds" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Move Break" Style="{StaticResource Settings.SectionTitle}" />
                <CheckBox Content="Enable move reminder"
                          IsChecked="{Binding MoveBreakEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <CheckBox AutomationProperties.AutomationId="MoveBreakSoundCheckbox"
                          Content="Play sound during move breaks"
                          IsChecked="{Binding MoveBreakSoundEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Move interval" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding MoveBreakIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Move duration" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding MoveBreakDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="seconds" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="Reminder behavior" Style="{StaticResource Settings.SectionTitle}" />
                <CheckBox Content="Allow skip" IsChecked="{Binding AllowSkip}" Style="{StaticResource Settings.CheckBoxRow}" />
                <CheckBox AutomationProperties.AutomationId="AllowSnoozeCheckbox"
                          Content="Allow snooze"
                          IsChecked="{Binding AllowSnooze}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Snooze duration" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox AutomationProperties.AutomationId="SnoozeDurationInput"
                           Grid.Column="1"
                           Text="{Binding SnoozeDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Style="{StaticResource Settings.ColumnStack}">
            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Break sound" Style="{StaticResource Settings.SectionTitle}" />
                <TextBlock Text="Choose the tone used by both reminders. Each reminder can enable or disable sound independently."
                           Style="{StaticResource Settings.PageDescription}"
                           Margin="0,0,0,10" />
                <RadioButton AutomationProperties.AutomationId="SoftBellSoundRadio"
                             GroupName="BreakSoundTheme"
                             Content="Soft bell"
                             IsChecked="{Binding IsSoftBellSelected}"
                             Style="{StaticResource Settings.SoundRadio}" />
                <RadioButton AutomationProperties.AutomationId="GentleChimeSoundRadio"
                             GroupName="BreakSoundTheme"
                             Content="Gentle chime"
                             IsChecked="{Binding IsGentleChimeSelected}"
                             Style="{StaticResource Settings.SoundRadio}" />
                <RadioButton AutomationProperties.AutomationId="CalmDropSoundRadio"
                             GroupName="BreakSoundTheme"
                             Content="Calm drop"
                             IsChecked="{Binding IsCalmDropSelected}"
                             Style="{StaticResource Settings.SoundRadio}"
                             Margin="0,0,0,12" />

                <TextBlock Text="Volume" Style="{StaticResource Settings.FieldLabel}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          AutomationProperties.AutomationId="BreakSoundVolumeSlider"
                          Minimum="0"
                          Maximum="100"
                          TickFrequency="1"
                          Value="{Binding BreakSoundVolume, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource Settings.GlassSlider}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding BreakSoundVolume, StringFormat={}{0}%}"
                             Style="{StaticResource Settings.GlassValue}" />
                </Grid>

                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Repeat every" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox AutomationProperties.AutomationId="BreakSoundRepeatInput"
                           Grid.Column="1"
                           Text="{Binding BreakSoundRepeatSeconds, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="seconds, minimum 1" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>

                <Button AutomationProperties.AutomationId="PreviewBreakSoundButton"
                        Content="Preview selected sound"
                        Command="{Binding PreviewSoundCommand}"
                        Style="{StaticResource Settings.SecondaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,2,0,8" />
                <TextBlock Text="The sound stops immediately when the break ends. The popup mute button affects only the current break."
                           Style="{StaticResource Settings.PageDescription}"
                           Margin="0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Idle and work hours" Style="{StaticResource Settings.SectionTitle}" />
                <CheckBox AutomationProperties.AutomationId="PauseWhileIdleCheckbox"
                          Content="Reset reminders after idle"
                          IsChecked="{Binding PauseWhileIdle}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Idle threshold" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="minutes" Style="{StaticResource Settings.FieldUnit}" />
                </Grid>
                <CheckBox Content="Enable work hours"
                          IsChecked="{Binding WorkHoursEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}"
                          Margin="0,0,0,6" />
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Work start" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                </Grid>
                <Grid Style="{StaticResource Settings.FieldRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Work end" Style="{StaticResource Settings.FieldLabel}" />
                  <TextBox Grid.Column="1"
                           Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Settings.InputTextBox}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource Settings.SectionTitle}" />
                <TextBlock Text="Glass clarity — 0 to 150"
                           Style="{StaticResource Settings.FieldLabel}"
                           Margin="0,0,0,8" />
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="GlassClaritySlider"
                          Grid.Column="0"
                          AutomationProperties.AutomationId="GlassClarityInput"
                          Value="{Binding GlassClarity}"
                          Style="{StaticResource Settings.GlassSlider}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding GlassClarity}"
                             Style="{StaticResource Settings.GlassValue}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Solid" Style="{StaticResource Settings.GlassScaleLabel}" />
                  <TextBlock Grid.Column="1" Text="Frosted" Style="{StaticResource Settings.GlassScaleLabel}" />
                  <TextBlock Grid.Column="2" Text="Clear" Style="{StaticResource Settings.GlassScaleLabel}" />
                  <TextBlock Grid.Column="3" Text="Extra clear" Style="{StaticResource Settings.GlassScaleLabel}" />
                </Grid>
                <CheckBox Content="Reduced motion"
                          IsChecked="{Binding ReducedMotion}"
                          Style="{StaticResource Settings.CheckBoxRow}"
                          Margin="0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="Windows behavior" Style="{StaticResource Settings.SectionTitle}" />
                <CheckBox Content="Run at Windows startup"
                          IsChecked="{Binding RunAtStartup}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <CheckBox Content="Start minimized"
                          IsChecked="{Binding StartMinimized}"
                          Style="{StaticResource Settings.CheckBoxRow}" />
                <CheckBox Content="Close dashboard to tray"
                          IsChecked="{Binding CloseToTray}"
                          Style="{StaticResource Settings.CheckBoxRow}"
                          Margin="0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1">
      <Border Margin="0,0,0,10">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Settings.ValidationPanel}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ValidationErrors.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ItemsControl ItemsSource="{Binding ValidationErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Settings.ValidationText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border Style="{StaticResource Settings.ActionBar}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button AutomationProperties.AutomationId="SettingsCloseButton"
                  Content="Close"
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource Settings.SecondaryButton}"
                  Margin="0,0,10,0" />
          <Button AutomationProperties.AutomationId="SettingsSaveButton"
                  Content="Save"
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource Settings.PrimaryButton}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
