<Window x:Class="Awayra.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="Settings"
        Width="1040"
        Height="760"
        MinWidth="800"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E1319"
        Foreground="#F7F9FC"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma"
        Validation.Error="OnFieldValidationError">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Settings.SoundRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Settings.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Settings.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="18" Height="18" Margin="0,0,9,0">
                  <Ellipse x:Name="Outer"
                           Fill="{StaticResource Settings.InputBackgroundBrush}"
                           Stroke="{StaticResource Settings.BorderBrush}"
                           StrokeThickness="1.5" />
                  <Ellipse x:Name="Dot"
                           Width="8"
                           Height="8"
                           Fill="{StaticResource Settings.AccentBrush}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource Settings.FocusRingBrush}" />
                  <Setter TargetName="Outer" Property="StrokeThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Settings.CompactFieldRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,7" />
      </Style>

      <Style x:Key="Settings.SubsectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Settings.AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Settings.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,2">
      <StackPanel>
        <TextBlock Text="Settings"
                   Foreground="{StaticResource Settings.PrimaryTextBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Text="Sound, exercise and reminder timing are grouped on the left. Behaviour, schedule, appearance and Windows options are on the right."
                   Style="{StaticResource Settings.PageDescription}"
                   Margin="0,3,0,10" />

        <Grid Style="{StaticResource Settings.TwoColumnGrid}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="360" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Style="{StaticResource Settings.ColumnStack}">
            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Break sound and exercise" Style="{StaticResource Settings.SectionTitle}" />
                <TextBlock Text="All six are generated locally. Morning dew and Still water fade in from silence."
                           Style="{StaticResource Settings.PageDescription}"
                           Margin="0,-4,0,8" />

                <UniformGrid Columns="3" Rows="2" Margin="0,0,0,4">
                  <RadioButton AutomationProperties.AutomationId="SoftBellSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Soft bell"
                               IsChecked="{Binding IsSoftBellSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                  <RadioButton AutomationProperties.AutomationId="GentleChimeSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Gentle chime"
                               IsChecked="{Binding IsGentleChimeSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                  <RadioButton AutomationProperties.AutomationId="CalmDropSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Calm drop"
                               IsChecked="{Binding IsCalmDropSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                  <RadioButton AutomationProperties.AutomationId="CalmPianoSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Calm piano"
                               IsChecked="{Binding IsCalmPianoSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                  <RadioButton AutomationProperties.AutomationId="MorningDewSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Morning dew"
                               IsChecked="{Binding IsMorningDewSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                  <RadioButton AutomationProperties.AutomationId="StillWaterSoundRadio"
                               GroupName="BreakSoundTheme"
                               Content="Still water"
                               IsChecked="{Binding IsStillWaterSelected}"
                               Style="{StaticResource Settings.SoundRadio}" />
                </UniformGrid>

                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="Volume"
                             Style="{StaticResource Settings.FieldLabel}"
                             Margin="0,0,12,0" />
                  <Slider Grid.Column="1"
                          AutomationProperties.AutomationId="BreakSoundVolumeSlider"
                          Minimum="0"
                          Maximum="100"
                          TickFrequency="1"
                          Value="{Binding BreakSoundVolume, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource Settings.GlassSlider}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding BreakSoundVolume, StringFormat={}{0}%}"
                             Style="{StaticResource Settings.GlassValue}"
                             Margin="10,0,0,0" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Repeat" Style="{StaticResource Settings.FieldLabel}" Margin="0,0,9,0" />
                  <TextBox AutomationProperties.AutomationId="BreakSoundRepeatInput"
                           Grid.Column="1"
                           Width="58"
                           Text="{Binding BreakSoundRepeatSeconds, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                           Style="{StaticResource Settings.InputTextBox}" />
                  <TextBlock Grid.Column="2" Text="sec" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                  <Button AutomationProperties.AutomationId="PreviewBreakSoundButton"
                          Grid.Column="4"
                          Content="Preview sound"
                          Command="{Binding PreviewSoundCommand}"
                          Style="{StaticResource Settings.SecondaryButton}"
                          Padding="13,7" />
                </Grid>

                <Border Height="1"
                        Background="{StaticResource Settings.BorderBrush}"
                        Margin="0,9,0,8" />

                <CheckBox AutomationProperties.AutomationId="BreakAnimationCheckbox"
                          Content="Show the guided exercise animation"
                          IsChecked="{Binding BreakAnimationEnabled}"
                          Style="{StaticResource Settings.CheckBoxRow}"
                          Margin="0" />
                <TextBlock Text="Off gives a plain countdown. Reduced motion keeps it without the movement."
                           Style="{StaticResource Settings.PageDescription}"
                           Margin="0,5,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="Reminder timers" Style="{StaticResource Settings.SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Eye Reset" Style="{StaticResource Settings.SubsectionTitle}" />
                    <CheckBox Content="Enable reminder"
                              IsChecked="{Binding EyeResetEnabled}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <CheckBox AutomationProperties.AutomationId="EyeBreakSoundCheckbox"
                              Content="Play sound"
                              IsChecked="{Binding EyeBreakSoundEnabled}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Interval" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="60"
                               Text="{Binding EyeResetIntervalMinutes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="min" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Duration" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="60"
                               Text="{Binding EyeResetDurationSeconds, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="sec" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                  </StackPanel>

                  <Border Grid.Column="1" Background="{StaticResource Settings.BorderBrush}" Margin="0,0,0,2" />

                  <StackPanel Grid.Column="3">
                    <TextBlock Text="Move Break" Style="{StaticResource Settings.SubsectionTitle}" />
                    <CheckBox Content="Enable reminder"
                              IsChecked="{Binding MoveBreakEnabled}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <CheckBox AutomationProperties.AutomationId="MoveBreakSoundCheckbox"
                              Content="Play sound"
                              IsChecked="{Binding MoveBreakSoundEnabled}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Interval" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="60"
                               Text="{Binding MoveBreakIntervalMinutes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="min" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Duration" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="60"
                               Text="{Binding MoveBreakDurationSeconds, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="sec" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <TextBlock Text="The overlay mute control affects only the break that is running."
                           Style="{StaticResource Settings.PageDescription}"
                           Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Style="{StaticResource Settings.ColumnStack}">
            <Border Style="{StaticResource Settings.SectionCard}">
              <StackPanel>
                <TextBlock Text="Behavior and schedule" Style="{StaticResource Settings.SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Reminder actions" Style="{StaticResource Settings.SubsectionTitle}" />
                    <CheckBox Content="Allow skip"
                              IsChecked="{Binding AllowSkip}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <CheckBox AutomationProperties.AutomationId="AllowSnoozeCheckbox"
                              Content="Allow snooze"
                              IsChecked="{Binding AllowSnooze}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Snooze" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox AutomationProperties.AutomationId="SnoozeDurationInput"
                               Grid.Column="1" Width="60"
                               Text="{Binding SnoozeDurationMinutes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="min" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                    <CheckBox AutomationProperties.AutomationId="PauseWhileIdleCheckbox"
                              Content="Reset after idle"
                              IsChecked="{Binding PauseWhileIdle}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Idle after" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="60"
                               Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                               Style="{StaticResource Settings.InputTextBox}" />
                      <TextBlock Grid.Column="2" Text="min" Style="{StaticResource Settings.FieldUnit}" Margin="7,0,0,0" />
                    </Grid>
                  </StackPanel>

                  <Border Grid.Column="1" Background="{StaticResource Settings.BorderBrush}" Margin="0,0,0,2" />

                  <StackPanel Grid.Column="3">
                    <TextBlock Text="Work hours" Style="{StaticResource Settings.SubsectionTitle}" />
                    <CheckBox Content="Enable work hours"
                              IsChecked="{Binding WorkHoursEnabled}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Start" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="76"
                               Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource Settings.InputTextBox}" />
                    </Grid>
                    <Grid Style="{StaticResource Settings.CompactFieldRow}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="End" Style="{StaticResource Settings.FieldLabel}" />
                      <TextBox Grid.Column="1" Width="76"
                               Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource Settings.InputTextBox}" />
                    </Grid>
                    <TextBlock Text="Outside this window, scheduled reminders wait until work hours resume."
                               Style="{StaticResource Settings.PageDescription}"
                               Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Settings.SectionCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="Appearance and Windows" Style="{StaticResource Settings.SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Overlay appearance" Style="{StaticResource Settings.SubsectionTitle}" />
                    <Grid Margin="0,0,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="GlassClaritySlider"
                              Grid.Column="0"
                              AutomationProperties.AutomationId="GlassClarityInput"
                              Value="{Binding GlassClarity}"
                              Style="{StaticResource Settings.GlassSlider}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding GlassClarity}"
                                 Style="{StaticResource Settings.GlassValue}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Solid" Style="{StaticResource Settings.GlassScaleLabel}" />
                      <TextBlock Grid.Column="1" Text="Clear" Style="{StaticResource Settings.GlassScaleLabel}" />
                      <TextBlock Grid.Column="2" Text="Extra" Style="{StaticResource Settings.GlassScaleLabel}" />
                    </Grid>
                    <CheckBox Content="Reduced motion"
                              IsChecked="{Binding ReducedMotion}"
                              Style="{StaticResource Settings.CheckBoxRow}"
                              Margin="0" />
                  </StackPanel>

                  <Border Grid.Column="1" Background="{StaticResource Settings.BorderBrush}" Margin="0,0,0,2" />

                  <StackPanel Grid.Column="3">
                    <TextBlock Text="Windows behavior" Style="{StaticResource Settings.SubsectionTitle}" />
                    <CheckBox Content="Run at Windows startup"
                              IsChecked="{Binding RunAtStartup}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <CheckBox Content="Start minimized"
                              IsChecked="{Binding StartMinimized}"
                              Style="{StaticResource Settings.CheckBoxRow}" />
                    <CheckBox Content="Close dashboard to tray"
                              IsChecked="{Binding CloseToTray}"
                              Style="{StaticResource Settings.CheckBoxRow}"
                              Margin="0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1">
      <Border Margin="0,0,0,8">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Settings.ValidationPanel}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ValidationErrors.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ItemsControl ItemsSource="{Binding ValidationErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Settings.ValidationText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border Style="{StaticResource Settings.ActionBar}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button AutomationProperties.AutomationId="SettingsCloseButton"
                  Content="Close"
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource Settings.SecondaryButton}"
                  Margin="0,0,10,0" />
          <Button AutomationProperties.AutomationId="SettingsSaveButton"
                  Content="Save"
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource Settings.PrimaryButton}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>