<Window x:Class="Awayra.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Awayra.Core.Models;assembly=Awayra.Core"
        Title="Settings"
        Width="520"
        Height="720"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding FlowDirection}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

      <Border Style="{StaticResource Awayra.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Eye Reset" FontWeight="SemiBold" Margin="0,0,0,8" />
          <CheckBox Content="Enabled" IsChecked="{Binding EyeResetEnabled}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Interval (minutes)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding EyeResetIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Duration (seconds)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding EyeResetDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Awayra.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Move Break" FontWeight="SemiBold" Margin="0,0,0,8" />
          <CheckBox Content="Enabled" IsChecked="{Binding MoveBreakEnabled}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Interval (minutes)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding MoveBreakIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Duration (seconds)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding MoveBreakDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Awayra.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,0,0,8" />
          <CheckBox Content="Allow skip" IsChecked="{Binding AllowSkip}" Margin="0,0,0,4" />
          <CheckBox Content="Allow snooze" IsChecked="{Binding AllowSnooze}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Snooze duration (minutes)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding SnoozeDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <CheckBox Content="Pause while idle" IsChecked="{Binding PauseWhileIdle}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Idle threshold (minutes)" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <CheckBox Content="Enable work hours" IsChecked="{Binding WorkHoursEnabled}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Work start" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding WorkStart, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Work end" Width="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          </StackPanel>
          <CheckBox Content="Run at Windows startup" IsChecked="{Binding RunAtStartup}" Margin="0,0,0,4" />
          <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,0,0,4" />
          <CheckBox Content="Close dashboard to tray" IsChecked="{Binding CloseToTray}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Awayra.Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Overlay opacity" Width="180" VerticalAlignment="Center" />
            <Slider Minimum="0.3" Maximum="1.0" Value="{Binding OverlayOpacity}" Width="180" />
          </StackPanel>
          <CheckBox Content="Reduced motion" IsChecked="{Binding ReducedMotion}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Language" Width="180" VerticalAlignment="Center" />
            <ComboBox SelectedItem="{Binding SelectedLanguage}" Width="180">
              <models:AppLanguage>Auto</models:AppLanguage>
              <models:AppLanguage>English</models:AppLanguage>
              <models:AppLanguage>Persian</models:AppLanguage>
              <models:AppLanguage>Arabic</models:AppLanguage>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,0,0,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" Command="{Binding CancelCommand}" Style="{StaticResource Awayra.SecondaryButton}" Margin="0,0,8,0" />
        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Awayra.PrimaryButton}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
