<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseWPF>false</UseWPF>
    <RootNamespace>Awayra.UiTests</RootNamespace>
    <!-- These UI tests intentionally use diagnostic assertion messages and
         hard timeouts around external desktop processes. Keep all other
         compiler and MSTest analyzer warnings enabled. -->
    <NoWarn>$(NoWarn);MSTEST0037;MSTEST0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Awayra.Core\Awayra.Core.csproj" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

</Project>
